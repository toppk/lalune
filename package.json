{
  "name": "@toppk/lalune",
  "version": "0.2.1",
  "description": "A Moon renderer using NASA imagery and location-aware astronomy.",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/toppk/lalune.git"
  },
  "homepage": "https://toppk.github.io/lalune/",
  "bugs": {
    "url": "https://github.com/toppk/lalune/issues"
  },
  "keywords": [
    "moon",
    "lunar",
    "astronomy",
    "nasa",
    "webgl",
    "threejs"
  ],
  "publishConfig": {
    "access": "public"
  },
  "type": "module",
  "license": "MIT",
  "files": [
    "dist",
    "assets",
    "docs",
    "examples",
    "ASSETS.md",
    "LICENSE",
    "THIRD_PARTY_NOTICES.txt",
    "CHANGELOG.md"
  ],
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
    },
    "./core": {
      "types": "./dist/core.d.ts",
      "import": "./dist/core.js"
    },
    "./assets/*": "./assets/*",
    "./dist/*": "./dist/*"
  },
  "sideEffects": false,
  "scripts": {
    "dev": "vite --host 127.0.0.1",
    "build": "npm run build:lib && npm run build:demo",
    "build:lib": "tsc -p tsconfig.lib.json && node scripts/build-browser.mjs",
    "build:demo": "vite build",
    "check": "tsc --noEmit",
    "test": "node --import tsx --test tests/*.test.ts",
    "test:bundles": "node --test tests/browser-builds.test.mjs",
    "assets:fetch": "node scripts/fetch-assets.mjs",
    "prepack": "npm run build:lib"
  },
  "dependencies": {
    "astronomy-engine": "^2.1.19",
    "three": "^0.180.0"
  },
  "devDependencies": {
    "@types/node": "^24.0.0",
    "@types/three": "^0.180.0",
    "esbuild": "^0.28.2",
    "sharp": "^0.35.5",
    "tsx": "^4.20.0",
    "typescript": "^5.9.0",
    "vite": "^7.1.0"
  },
  "unpkg": "./dist/lalune.iife.min.js",
  "jsdelivr": "./dist/lalune.iife.min.js"
}
